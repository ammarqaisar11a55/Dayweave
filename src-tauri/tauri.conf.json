{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dayweave",
  "mainBinaryName": "dayweave",
  "version": "0.1.0",
  "identifier": "io.github.ammarqaisar11a55.dayweave",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dayweave",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "Build better days, one habit at a time",
    "longDescription": "Dayweave brings tasks, deadlines, habits, a calendar, focus sessions and analytics together in one private application. All data stays on your computer.",
    "copyright": "Copyright 2026 Muhammad Ammar Qaisar",
    "license": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "desktopTemplate": "dayweave.desktop",
        "depends": ["libayatana-appindicator3-1"]
      }
    }
  }
}
